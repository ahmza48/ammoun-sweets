# ─────────────────────────────────────────────────────────────────────────────
# AMMOUN SWEETS — environment
#
# Copy to .env.local for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Production: a managed PostgreSQL connection string.
#   DATABASE_URL=postgresql://user:password@host:5432/ammoun_sweets
#
# Development: `file:./.pglite` runs PGlite, real PostgreSQL embedded in the
# process — no server, no Docker. Leave unset for a throwaway in-memory database.
DATABASE_URL=file:./.pglite

# Set to "false" only for a local Postgres without TLS.
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# ── Application ─────────────────────────────────────────────────────────────
# Absolute origin. Used in emails and payment redirects — never localhost in
# production.
APP_URL=http://localhost:3000

# Signs the session cookie. Generate with: openssl rand -base64 32
# REQUIRED in production; the app refuses to start without it.
SESSION_SECRET=

# ── Payments ────────────────────────────────────────────────────────────────
# There is no online payment and no gateway to configure.
#
# Customers order for collection and pay in the shop — cash or card at the
# counter. Staff tick an order off as paid from the admin order page, which is
# the only thing that ever sets payment status to PAID. Nothing in this
# application can charge a card, and no card details ever reach it.
#
# If online payment is ever added, it belongs behind a new service in
# src/server/services/ plus its own credentials here; nothing else about the
# checkout needs to change, because the price is already computed server-side.

# ── Email ───────────────────────────────────────────────────────────────────
# "resend" | "console". Console logs instead of sending — the default in dev.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be a domain verified with your email provider.
EMAIL_FROM="Ammoun Sweets <orders@your-domain.com>"

# ── First admin ─────────────────────────────────────────────────────────────
# Used once by `pnpm db:seed --with-admin`. There is deliberately no default
# admin account. Minimum 12 characters. Remove these after the first run.
SEED_ADMIN_EMAIL= ahmza48.dev@gmail.com
SEED_ADMIN_PASSWORD=Soldier484848
